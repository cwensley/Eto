<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:e="clr-namespace:Eto.Wpf">

    <!--
    =========================================================================
    PALETTE THEME
    =========================================================================
    A reusable, palette-driven theme for Eto.Wpf applications. All control
    styles reference named palette brushes/colors via DynamicResource, so an
    application creates a custom theme by supplying ONLY a palette resource
    dictionary defining the Eto.Palette.* colors and brushes, e.g.:

        ThemesHandler.Instance.RegisterTheme(
			new PaletteThemeHandler(
				"My Theme", 
				ThemeStyle.Dark,
            	new Uri("pack://application:,,,/MyApp;component/themes/MyPalette.xaml")
			)
		);

    See test/Eto.Test.Wpf/themes/custom/*Palette.xaml for complete example
    palettes (the keys defined there are the contract this theme consumes).

    Layout
    ======
    1. MergedDictionaries (lowest priority, searched last):
         a. themes/generic.xaml    — Eto.Wpf base control templates
         b. themes/palette/*.xaml  — style overrides using DynamicResource
                                     palette references
    2. Outer dictionary resources (highest priority, searched first):
         • SystemColors brush overrides — redirect WPF's System brush keys to
           the palette so every standard WPF control (Button, TextBox,
           ComboBox, DataGrid, …) picks up the palette via its built-in
           DynamicResource references. These use DynamicResource for the
           Color values because the application's palette dictionary is a
           sibling merged dictionary supplied at runtime.
         • EtoBorderBezelBrush — Eto-specific border brush.

    The matching SystemColors *ColorKey* resources (WindowColorKey,
    ControlTextColorKey, HighlightColorKey, …), which a few generic control
    templates consume directly, are NOT overridden here: a Color resource entry
    cannot reference another resource (neither DynamicResource nor StaticResource
    parses into a Color), and this file is parsed before the palette is merged, so
    the literal colors are unknown. PaletteThemeHandler.ThemeResourcesMerged copies
    each Eto.Palette.*.Color into the corresponding *ColorKey in code once the
    palette has been merged. Keep that mapping in sync with the brush overrides below.

    To change colors at runtime (live theme preview), replace the *brush* in
    Application.Current.Resources (main dict, not a merged one):
        Application.Current.Resources["Eto.Palette.AccentBrush"] = new SolidColorBrush(color);
    =========================================================================
    -->

    <ResourceDictionary.MergedDictionaries>
        <e:AssemblyAbsoluteResourceDictionary Path="themes/generic.xaml" />

        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoComboBox.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoCustomComboBox.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoTextBox.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoSearchBox.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoButton.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoToggleButton.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoBooleanControls.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoSlider.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoProgressBar.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoGroupBox.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoExpander.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoTabControl.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/ScrollBarStyles.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoScrollViewer.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoListBox.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoDataGrid.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoCalendar.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoToolBar.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoMenu.xaml" />
        <e:AssemblyAbsoluteResourceDictionary Path="themes/palette/EtoMenuItem.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═ Backgrounds ══════════════════════════════════════════════════════ -->
    <!-- Window / TextBox / ListBox / DataGrid cell background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{DynamicResource Eto.Palette.Background.Color}" />
    <!-- Panel / GroupBox / control fill (ControlBrush is used by Button etc.) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                     Color="{DynamicResource Eto.Palette.Surface.Color}" />
    <!-- Eto.Drawing.SystemColors.ControlBackground (the entry area of controls such as a TextBox).
         Palette inputs use the Surface brush, so report that rather than the tinted window background. -->
    <SolidColorBrush x:Key="ControlBackground"
                     Color="{DynamicResource Eto.Palette.Surface.Color}" />
    <!-- Lighter inset controls (ControlLightBrush used by some WPF templates) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"
                     Color="{DynamicResource Eto.Palette.Background.Color}" />
    <!-- Scroll area / info tip background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}"
                     Color="{DynamicResource Eto.Palette.Background.Color}" />

    <!-- ═ Foregrounds ══════════════════════════════════════════════════════ -->
    <!-- Primary text color -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.Foreground.Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.Foreground.Color}" />
    <!-- Info-tip text -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.Foreground.Color}" />
    <!-- Placeholder / watermark / disabled text -->
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.SubtleForeground.Color}" />

    <!-- ═ Selection / highlight ════════════════════════════════════════════ -->
    <!-- Active selection background (focused ListBox rows, selected text, …) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="{DynamicResource Eto.Palette.Accent.Color}" />
    <!-- Text drawn over the active selection background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.AccentForeground.Color}" />
    <!-- Inactive selection background (unfocused list, etc.) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                     Color="{DynamicResource Eto.Palette.HoverBackground.Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.Foreground.Color}" />

    <!-- ═ Borders ══════════════════════════════════════════════════════════ -->
    <!-- Standard control border (used by ButtonSpinner, ComboBox, etc.) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"
                     Color="{DynamicResource Eto.Palette.Border.Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}"
                     Color="{DynamicResource Eto.Palette.Border.Color}" />
    <!-- Window / dialog frame -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}"
                     Color="{DynamicResource Eto.Palette.Border.Color}" />
    <!-- Active window border (focus rings, active caption) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}"
                     Color="{DynamicResource Eto.Palette.Accent.Color}" />
    <!-- Inactive / unfocused window border -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}"
                     Color="{DynamicResource Eto.Palette.Border.Color}" />

    <!-- ═ Menus ════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"
                     Color="{DynamicResource Eto.Palette.Background.Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"
                     Color="{DynamicResource Eto.Palette.Surface.Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"
                     Color="{DynamicResource Eto.Palette.Foreground.Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"
                     Color="{DynamicResource Eto.Palette.Accent.Color}" />

    <!-- ── Eto-specific ─────────────────────────────────────────────────── -->
    <!-- Used by EtoButtonSpinner and a handful of other Eto controls -->
    <SolidColorBrush x:Key="EtoBorderBezelBrush"
                     Color="{DynamicResource Eto.Palette.Border.Color}" />

    <!-- ═ Shape / spacing (optional palette overrides) ═════════════════════ -->
    <!--
    These are the DEFAULTS for the palette-tunable shape keys. A palette file
    (e.g. MochaPalette.xaml) is merged AFTER this dictionary, so it can override
    any of these to opt into rounded corners and matching padding. If a palette
    does not define them, these defaults apply and the controls keep their
    original square, tightly-padded look — so the feature is fully opt-in.

        Eto.Palette.CornerRadius   - corner radius applied to the outer chrome of
                                     TextBox / ComboBox (DropDown) / Button, the combo
                                     drop-down popup, DateTimePicker and NumericStepper.
                                     (This same key also drives DateTimePicker/NumericStepper
                                     rounding in the generic + fluent themes.)
        Eto.Palette.ControlPadding - inner padding for text-entry & combo controls;
                                     widen it to keep content clear of rounded corners.
        Eto.Palette.ButtonPadding  - inner padding for buttons.
    -->
    <CornerRadius x:Key="Eto.Palette.CornerRadius">0</CornerRadius>
    <Thickness x:Key="Eto.Palette.ControlPadding">4,2</Thickness>
    <Thickness x:Key="Eto.Palette.ButtonPadding">8,4</Thickness>

</ResourceDictionary>
